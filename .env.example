GEMINI_API_KEY=
# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_SAFETY_MODEL=gemini-3.8-flash
# CALLER_SALT=change-me
# Require ?token= (or a Bearer header) for the dashboard API. Set this before deploying.
# DASHBOARD_TOKEN=
# Chert / LiveKit keys go in .env.local
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Name of the FaceTime camera track Chert publishes ('*' = any caller video)
# CALLER_VIDEO_TRACK=facetime-remote-video
# Optional MongoDB Atlas copy of the call logs (JSONL files stay the source of truth)
# MONGODB_URI=
# MONGODB_DB=genesis
